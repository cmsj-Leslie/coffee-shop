<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coffeeshop.mapper.CouponMapper">

    <resultMap type="com.coffeeshop.entity.Coupon" id="CouponMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="type" column="type" jdbcType="INTEGER"/>
        <result property="minAmount" column="min_amount" jdbcType="DECIMAL"/>
        <result property="reduceAmount" column="reduce_amount" jdbcType="DECIMAL"/>
        <result property="discount" column="discount" jdbcType="DECIMAL"/>
        <result property="startTime" column="start_time" jdbcType="TIMESTAMP"/>
        <result property="endTime" column="end_time" jdbcType="TIMESTAMP"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="status" column="status" jdbcType="INTEGER"/>
    </resultMap>

    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO coupon (name, type, min_amount, reduce_amount, discount, start_time, end_time, create_time, status)
        VALUES (#{name}, #{type}, #{minAmount}, #{reduceAmount}, #{discount}, #{startTime}, #{endTime}, #{createTime}, #{status})
    </insert>

    <delete id="deleteById">
        DELETE FROM coupon WHERE id = #{id}
    </delete>

    <select id="getById" resultMap="CouponMap">
        SELECT * FROM coupon WHERE id = #{id}
    </select>

    <select id="listCoupons" resultMap="CouponMap">
        SELECT * FROM coupon ORDER BY create_time ASC
    </select>

    <update id="update">
        UPDATE coupon
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="type != null">type = #{type},</if>
            <if test="minAmount != null">min_amount = #{minAmount},</if>
            <if test="reduceAmount != null">reduce_amount = #{reduceAmount},</if>
            <if test="discount != null">discount = #{discount},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
