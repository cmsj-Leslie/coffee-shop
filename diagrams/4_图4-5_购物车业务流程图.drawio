          <mxGeometry x="360" y="460" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="stock_check" value="库存是否充足？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman, Microsoft YaHei;" vertex="1" parent="1">
